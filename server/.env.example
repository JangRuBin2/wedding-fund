# SQLite 파일 경로 (Postgres로 바꾸려면 schema.prisma provider도 같이 변경)
DATABASE_URL="file:./data.db"

# 폰 앱 → 서버 인증 토큰. 길고 랜덤하게: openssl rand -hex 32
INGEST_TOKEN="change-me"

# 대시보드 비밀번호 (브라우저 Basic Auth, 아이디는 아무거나). 비우면 잠금 없음
DASHBOARD_PASSWORD="change-me"

# 주간 피드백 크론 호출용 시크릿
CRON_SECRET="change-me"

# 있으면 가맹점 자동분류 + 주간 피드백을 Claude가 작성. 없으면 규칙 기반으로 동작
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-5-5"
