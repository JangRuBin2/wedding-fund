# Postgres 주소. Vercel에서 Neon 연동하면 DATABASE_URL / DATABASE_URL_UNPOOLED 가 자동으로 들어감
# 로컬 개발은 Neon 대시보드의 주소를 복사하거나 로컬 Postgres 사용
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_fund"
# (선택) 풀러를 거치지 않는 직접 주소. 있으면 prisma db push 가 이걸 씀
DATABASE_URL_UNPOOLED=""

# 폰 앱 → 서버 인증 토큰. 길고 랜덤하게: openssl rand -hex 32
INGEST_TOKEN="change-me"

# 대시보드 비밀번호 (브라우저 Basic Auth, 아이디는 아무거나). 비우면 잠금 없음
DASHBOARD_PASSWORD="change-me"

# 주간 피드백 크론 호출용 시크릿 (Vercel Cron이 이 값을 Bearer 토큰으로 자동 첨부)
CRON_SECRET="change-me"

# 있으면 가맹점 자동분류 + 주간 피드백을 Gemini가 작성. 없으면 규칙 기반으로 동작
# Google AI Studio(https://aistudio.google.com/apikey)에서 무료 발급, 카드 등록 없이 프리티어로 사용
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
