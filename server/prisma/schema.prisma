// Prisma 7 (Rust 엔진 없는 클라이언트 + driver adapter). DB 주소는 prisma.config.ts에서 읽음.
// DB는 Postgres (Vercel + Neon 무료 티어 기준). 런타임 연결은 src/lib/db.ts 의 adapter-pg.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 결제 알림을 보내는 사람 (커플 공유 모드: 기기마다 이름을 다르게 설정)
model Member {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

/// 폰에서 넘어온 알림 원문. 파서를 고치면 재처리할 수 있게 전부 보관
model RawNotification {
  id            String       @id @default(cuid())
  packageName   String
  title         String
  text          String
  postedAt      DateTime
  hash          String       @unique
  result        String // PARSED | DUPLICATE | SKIPPED | CANCEL_MATCHED
  memberName    String?
  createdAt     DateTime     @default(now())
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  transactionId String?
}

model Transaction {
  id         String            @id @default(cuid())
  type       String // EXPENSE | INCOME
  amount     Int
  merchant   String
  category   String
  occurredAt DateTime
  source     String // NOTIFICATION | MANUAL
  issuer     String?
  memo       String?
  /// CONFIRMED: 확정, REVIEW: 파싱이 애매해서 확인 필요, IGNORED: 무시(가계부 집계 제외)
  status     String            @default("CONFIRMED")
  cancelled  Boolean           @default(false)
  member     Member?           @relation(fields: [memberId], references: [id])
  memberId   String?
  raws       RawNotification[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([occurredAt])
  @@index([merchant])
}

/// 가맹점 → 카테고리 학습 규칙 (사용자가 수정하거나 LLM이 분류한 결과)
model MerchantRule {
  id        String   @id @default(cuid())
  merchant  String   @unique
  category  String
  source    String   @default("USER") // USER | LLM
  createdAt DateTime @default(now())
}

/// 결혼자금 목표 (단일 레코드)
model Goal {
  id           Int      @id @default(1)
  title        String   @default("결혼자금")
  targetAmount Int
  /// 추적 시작 시점에 이미 모아둔 금액
  startAmount  Int      @default(0)
  startDate    DateTime
  targetDate   DateTime
  /// 이 금액 이상 결제하면 충동구매 넛지
  bigSpendThreshold Int @default(50000)
  updatedAt    DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  weekStart DateTime @unique
  content   String
  model     String
  createdAt DateTime @default(now())
}

/// 결혼 예산표 항목 (예식장, 스드메, 신혼여행 …). 낸 돈은 직접 기록
model WeddingItem {
  id        String    @id @default(cuid())
  name      String
  /// 예식 | 스드메 | 예물·예단 | 신혼여행 | 신혼집·혼수 | 기타
  group     String    @default("기타")
  budget    Int       @default(0)
  paid      Int       @default(0)
  /// 남은 돈(잔금) 낼 날짜
  dueDate   DateTime?
  memo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// 결혼 준비 이벤트 (시트의 '전체 흐름' 20단계 + 직접 추가). 체크리스트·메모·결제를 묶는 큰 카테고리
model WeddingStep {
  id          String        @id @default(cuid())
  order       Int
  title       String
  /// 시트의 '비고'
  note        String?
  /// 템플릿에 고정된 안내 (하객 수 → 웨딩홀·청첩장)
  hint        String?
  targetDate  DateTime?
  done        Boolean       @default(false)
  doneAt      DateTime?
  /// 체크한 사람 (Member.name)
  doneBy      String?
  /// 템플릿을 여러 번 불러와도 중복되지 않게
  templateKey String?       @unique
  tasks       WeddingTask[]
  payments    WeddingPayment[]
}

/// 단계 안의 세부 할 일
model WeddingTask {
  id        String      @id @default(cuid())
  step      WeddingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId    String
  /// 시트의 세부 칸 이름 (상견례 / 드레스 피팅 / 행정·혜택 …)
  section   String?
  content   String
  /// 소규모 일정 (예: 촬영용 옷 구매 10월 3일). 캘린더에 같이 보임
  dueDate   DateTime?
  done      Boolean     @default(false)
  doneAt    DateTime?
  doneBy    String?
  createdBy String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([stepId])
}

/// 팁을 사람에 맞게 거르기 위한 정보. 비워 두면 그 조건은 안 따지고 다 보여 줌
model Profile {
  /// Member.name 과 같은 이름 (폰 앱에 입력한 이름)
  name               String   @id
  birthYear          Int?
  /// 중소기업 재직 여부
  smallCompany       Boolean?
  /// 월세 | 전세 | 자가 | 가족과 함께
  housing            String?
  householder        Boolean?
  /// 올해 이직(퇴사)했는지
  changedJobThisYear Boolean?
  /// 혼인신고 했는지
  married            Boolean?
  updatedAt          DateTime @updatedAt
}

/// 이벤트별 결제 기록 (예산 구분 = WeddingBudget.category 와 같은 이름)
model WeddingPayment {
  id        String       @id @default(cuid())
  step      WeddingStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  stepId    String?
  /// 예식 | 스드메 | 예물·예단 | 신혼여행 | 신혼집·혼수 | 기타
  category  String
  content   String
  amount    Int
  /// CARD | CASH | PLANNED(결제 예정)
  method    String       @default("CARD")
  /// GROOM | BRIDE | OTHER
  payer     String       @default("GROOM")
  /// 결제자가 기타일 때 (예: 부모님)
  payerNote String?
  /// 결제한 날, 결제 예정이면 예정일
  paidAt    DateTime?
  createdBy String?
  createdAt DateTime     @default(now())

  @@index([stepId])
  @@index([category])
}

/// 예산 구분별 배분액. 합계가 결혼 총예산
model WeddingBudget {
  category  String   @id
  amount    Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 카카오로 로그인한 사람. 처음 로그인한 사람이 OWNER, 그다음부터는 OWNER가 승인해야 들어올 수 있음
model User {
  id          String    @id @default(cuid())
  kakaoId     String    @unique
  nickname    String?
  /// 대시보드에서 쓰는 이름. 폰 앱에 입력한 이름(Member.name)과 같게 맞추면 체크 기록·팁 맞춤이 이어짐
  name        String
  /// OWNER | MEMBER
  role        String    @default("MEMBER")
  /// APPROVED | PENDING | REJECTED
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}
